#define _CRT_SECURE_NO_WARNINGS
#include <iostream>
#include <cstring>

using namespace std;

class Student {
private:
	const int id;
	string nume;
	int varsta;
	int nrNote;
	float* note;
	static int nrStudenti;
public:
	Student() :id(++nrStudenti) {
		this->nume = "Student necunoscut";
		this->varsta = 0;
		this->nrNote = 0;
		this->note = nullptr;
	}
	Student(string nume, int varsta, int nrNote, float* noteStudenti) :id(++nrStudenti) {
		this->nume = nume;
		this->varsta = varsta;
		this->nrNote = nrNote;
		this->note = new float[this->nrNote];
		for (int i = 0; i < this->nrNote; i++) {
			this->note[i] = noteStudenti[i];
		}
		delete[] noteStudenti;
	}
	void afisareStudent() {
		cout << id << ". Studentul " << this->nume << " are varsta de " << this->varsta << " ani si are un numar de " << this->nrNote << " note: " << endl;
		if (this->note != nullptr) {
			for (int i = 0; i < nrNote - 1; i++) {
				cout << this->note[i] << " , ";
			}
			cout << this->note[this->nrNote - 1] << " . ";
		}
	}
	~Student() {
		if (this->note != nullptr) {
			delete[] this->note;
		}
	}
};

int Student::nrStudenti = 0;

void main() {
	Student s1;

	s1.afisareStudent();
	float* note = new float[3] {4, 5, 6};
	Student* s2 = new Student("Raul", 20, 3, note);

	s2->afisareStudent();

	delete s2;
}
